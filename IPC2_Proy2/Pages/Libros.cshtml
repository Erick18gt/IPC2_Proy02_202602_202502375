@page
@model IPC2_Proy2.Pages.LibrosModel
@{
    ViewData["Title"] = "Libros";
}

<h2>Gestión de libros</h2>

<h3>Registrar nuevo libro</h3>
<form method="post" asp-page-handler="Registrar">
    <div class="mb-2">
        <label class="form-label">ISBN</label>
        <input type="number" class="form-control" asp-for="IsbnRegistrar" required />
    </div>
    <div class="mb-2">
        <label class="form-label">Título</label>
        <input type="text" class="form-control" asp-for="TituloRegistrar" required />
    </div>
    <div class="mb-2">
        <label class="form-label">Autor</label>
        <input type="text" class="form-control" asp-for="AutorRegistrar" required />
    </div>
    <div class="mb-2">
        <label class="form-label">Categoría</label>
        <input type="text" class="form-control" asp-for="CategoriaRegistrar" required />
    </div>
    <button type="submit" class="btn btn-primary">Registrar</button>
</form>

<hr />

<h3>Buscar / eliminar por ISBN</h3>
<form method="post">
    <div class="mb-2">
        <label class="form-label">ISBN</label>
        <input type="number" class="form-control" asp-for="IsbnConsulta" required />
    </div>
    <button type="submit" asp-page-handler="Buscar" class="btn btn-secondary">Buscar</button>
    <button type="submit" asp-page-handler="Eliminar" class="btn btn-danger">Eliminar</button>
</form>

@if (Model.LibroEncontrado != null)
{
    <div class="alert alert-info mt-3">@Model.LibroEncontrado.ToString()</div>
}

<hr />

<h3>Menor y mayor ISBN del catálogo</h3>
<form method="post">
    <button type="submit" asp-page-handler="MenorMayor" class="btn btn-secondary">Consultar</button>
</form>

@if (Model.LibroMenor != null || Model.LibroMayor != null)
{
    <p class="mt-3"><strong>Menor ISBN:</strong> @(Model.LibroMenor?.ToString() ?? "No hay libros")</p>
    <p><strong>Mayor ISBN:</strong> @(Model.LibroMayor?.ToString() ?? "No hay libros")</p>
}

@if (Model.Mensaje != null)
{
    <div class="alert @(Model.Exito ? "alert-success" : "alert-danger") mt-3">
        @Model.Mensaje
    </div>
}

<a asp-page="/Index" class="btn btn-link mt-3">Volver al menú</a>
