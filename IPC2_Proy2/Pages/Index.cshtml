@page
@model IPC2_Proy2.Pages.IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center">
    <h1 class="display-4">Sistema de Catálogo de Librería</h1>
    <p>Proyecto No. 2 - Introducción a la Programación y Computación 2</p>
</div>

<div class="row mt-4">
    <div class="col-md-4 mb-3">
        <div class="card border-primary h-100">
            <div class="card-header bg-primary text-white">Cargar XML</div>
            <div class="card-body">
                <p class="card-text">Carga un archivo entrada.xml con categorías y/o libros.</p>
                <a asp-page="/CargarXml" class="btn btn-primary">Ir</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-success h-100">
            <div class="card-header bg-success text-white">Categorías</div>
            <div class="card-body">
                <p class="card-text">Ver la estructura del catálogo o agregar una nueva categoría.</p>
                <a asp-page="/Categorias" class="btn btn-success">Ir</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-warning h-100">
            <div class="card-header bg-warning">Libros</div>
            <div class="card-body">
                <p class="card-text">Registrar, eliminar o buscar libros del catálogo.</p>
                <a asp-page="/Libros" class="btn btn-warning">Ir</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-info h-100">
            <div class="card-header bg-info text-white">Reporte gráfico</div>
            <div class="card-body">
                <p class="card-text">Ver los libros de una categoría de forma gráfica (Graphviz).</p>
                <a asp-page="/Graphviz" class="btn btn-info text-white">Ir</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-secondary h-100">
            <div class="card-header bg-secondary text-white">Ayuda</div>
            <div class="card-body">
                <p class="card-text">Datos del estudiante y enlace a la documentación.</p>
                <a asp-page="/Ayuda" class="btn btn-secondary">Ir</a>
            </div>
        </div>
    </div>
</div>
