@page
@model IPC2_Proy2.Pages.GraphvizModel
@{
    ViewData["Title"] = "Reporte gráfico";
}

<h2>Reporte gráfico de una categoría (Graphviz)</h2>

<form method="post">
    <div class="mb-2">
        <label class="form-label">Nombre de la categoría</label>
        <input type="text" class="form-control" asp-for="NombreCategoria" required />
    </div>
    <button type="submit" class="btn btn-primary">Generar</button>
</form>

@if (Model.Mensaje != null)
{
    <div class="alert alert-danger mt-3">@Model.Mensaje</div>
}

@if (Model.RutaImagen != null)
{
    <div class="mt-3">
        <div class="mb-2 d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="cambiarZoom(20)">Acercar (+)</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="cambiarZoom(-20)">Alejar (-)</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="restablecerZoom()">Restablecer</button>
            <a href="@Model.RutaImagen" target="_blank" class="btn btn-sm btn-outline-primary">Abrir en pestaña nueva</a>
        </div>
        <div id="contenedorGrafico" class="border rounded" style="overflow: auto; max-height: 650px; background: #fafafa;">
            <img id="imagenGrafico" src="@Model.RutaImagen" style="width: 100%; min-width: 100%;" alt="Gráfico de la categoría" />
        </div>
        <small class="text-muted">Tip: usa los botones para acercar o alejar, y arrastra las barras de desplazamiento para recorrer catálogos grandes. Al ser SVG (vectorial), no pierde nitidez sin importar cuántos libros tenga la categoría.</small>
    </div>

    <script>
        let zoomActual = 100;

        function cambiarZoom(delta) {
            zoomActual = Math.max(20, Math.min(500, zoomActual + delta));
            document.getElementById('imagenGrafico').style.width = zoomActual + '%';
        }

        function restablecerZoom() {
            zoomActual = 100;
            document.getElementById('imagenGrafico').style.width = '100%';
        }
    </script>
}

<a asp-page="/Index" class="btn btn-link mt-3">Volver al menú</a>
