@page
@model IPC2_Proy2.Pages.GraphvizModel
@{
    ViewData["Title"] = "Reporte gráfico";
}

<h2>Reporte gráfico de una categoría (Graphviz)</h2>

<form method="post">
    <div class="mb-2">
        <label class="form-label">Nombre de la categoría</label>
        <input type="text" class="form-control" asp-for="NombreCategoria" required />
    </div>
    <button type="submit" class="btn btn-primary">Generar</button>
</form>

@if (Model.Mensaje != null)
{
    <div class="alert alert-danger mt-3">@Model.Mensaje</div>
}

@if (Model.RutaImagen != null)
{
    <div class="mt-3">
        <img src="@Model.RutaImagen" class="img-fluid border" alt="Gráfico de la categoría" />
    </div>
}

<a asp-page="/Index" class="btn btn-link mt-3">Volver al menú</a>
